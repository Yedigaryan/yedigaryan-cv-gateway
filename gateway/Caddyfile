# Caddy config for the public Render edge of the LLM gateway.
# Render terminates TLS upstream, so auto_https stays off.
# All public traffic must carry `Authorization: Bearer $LLM_API_TOKEN`
# except the /health probe (Render orchestration) and CORS preflights.
#
# CORS uses Access-Control-Allow-Origin: * because the resource is bearer-
# token-gated — anyone with the token can call it from anywhere, so the
# CORS check adds no security beyond what the bearer already enforces. We
# explicitly do NOT set Access-Control-Allow-Credentials, which keeps the
# wildcard origin valid (browsers only reject `*` when credentials: 'include').

{
    # Render terminates TLS upstream — Caddy must not bind 80/443.
    auto_https off

    # Disable Caddy's admin API entirely. We configure the gateway
    # statically through this file; runtime config changes via the REST
    # admin endpoint are not used. Disabling it stops the trickle of
    # `admin.api` "host not allowed" 403s from external port scanners and
    # removes a small attack surface. To re-enable for live debugging:
    # comment this line out and `kubectl exec`/Render-shell to localhost:2019.
    admin off
}

:{$PORT:10000} {
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

        # CORS — applied to every response, including 401s.
        Access-Control-Allow-Origin "*"
        Access-Control-Allow-Methods "POST, GET, OPTIONS"
        Access-Control-Allow-Headers "Authorization, Content-Type"
        Access-Control-Max-Age "86400"
    }

    # Render orchestration probe — always open.
    handle /health {
        respond "OK" 200
    }

    # CORS preflight — must answer before the auth check, or the browser
    # never sends the real request.
    @preflight method OPTIONS
    handle @preflight {
        respond "" 204
    }

    # ------------------------------------------------------------------
    # Claude-CLI backend (subscription-mode) on the laptop's :11435.
    #
    # Routed under /v1/claude/*. `handle_path` strips the /v1/claude
    # prefix, so the wrapper receives POST /chat/completions (which it
    # accepts alongside its native /v1/chat/completions path).
    #
    # Reaches the laptop via a SECOND socat bridge on :18081 tunneling
    # to $LLM_BACKEND_CLAUDE (see run.sh). All the streaming / CORS /
    # timeout considerations that apply to the Ollama block below apply
    # here identically — the two blocks stay in sync by convention.
    # ------------------------------------------------------------------
    handle_path /v1/claude/* {
        @claudeAuthorized header Authorization "Bearer {$LLM_API_TOKEN}"
        handle @claudeAuthorized {
            reverse_proxy localhost:18081 {
                header_up Host "localhost:11435"
                header_up X-Forwarded-For {remote_host}

                header_down X-Accel-Buffering no
                flush_interval -1

                # Strip any CORS the wrapper emits — we set them
                # globally above; duplicates trip Chrome's CORS check.
                header_down -Access-Control-Allow-Origin
                header_down -Access-Control-Allow-Methods
                header_down -Access-Control-Allow-Headers
                header_down -Access-Control-Allow-Credentials
                header_down -Access-Control-Max-Age
                header_down -Access-Control-Expose-Headers

                transport http {
                    # Claude first-token latency is usually <5 s but a
                    # long generation can stream for a minute or more.
                    read_timeout 300s
                    write_timeout 300s
                    dial_timeout 10s
                    keepalive off
                }
            }
        }
        handle {
            respond "Unauthorized" 401 {
                close
            }
        }
    }

    # Authenticated traffic flows through the Tailscale tunnel to the
    # laptop running Ollama at $LLM_BACKEND (e.g. 100.x.y.z:11434).
    @authorized header Authorization "Bearer {$LLM_API_TOKEN}"
    handle @authorized {
        # Caddy dials localhost:18080 — a socat listener (see run.sh) that
        # tunnels each TCP connection through Tailscale's HTTP-CONNECT
        # proxy to ${LLM_BACKEND} on the laptop. From Caddy's perspective
        # this is a normal direct dial; the tunneling is transparent.
        reverse_proxy localhost:18080 {
            # Override Host with the literal upstream so Ollama's anti-
            # DNS-rebinding origin-check sees a "trusted" host. Without
            # this Ollama returns 301/403 because the Host header would
            # otherwise be the public Render hostname.
            header_up Host "localhost:11434"
            header_up X-Forwarded-For {remote_host}

            # Tell intermediaries (Cloudflare in front of Render, any
            # buffering proxy) to NOT buffer the SSE response. Without
            # these the streaming response can be held back until enough
            # bytes accumulate, then released in one shot — which the
            # browser interprets as a stalled stream and the fetch errors
            # out before the first byte arrives. `X-Accel-Buffering: no`
            # is the de-facto signal honored by nginx/Cloudflare/Render.
            header_down X-Accel-Buffering no

            # Flush each chunk to the client as it arrives from upstream
            # instead of waiting for response buffering thresholds.
            flush_interval -1

            # Strip CORS headers Ollama emits when OLLAMA_ORIGINS=* is
            # set on the laptop — we set them ourselves in the global
            # header{} block above. Forwarding upstream's copy results
            # in duplicate `Access-Control-Allow-Origin` headers, which
            # Chrome rejects as a CORS violation (the response shows
            # 200 OK in DevTools but the body never reaches JS).
            header_down -Access-Control-Allow-Origin
            header_down -Access-Control-Allow-Methods
            header_down -Access-Control-Allow-Headers
            header_down -Access-Control-Allow-Credentials
            header_down -Access-Control-Max-Age
            header_down -Access-Control-Expose-Headers

            transport http {
                # Ollama's first response after a cold model load can
                # take 30-120s. Caddy's 30s default would 502 mid-stream.
                read_timeout 300s
                write_timeout 300s
                dial_timeout 10s

                # Disable upstream HTTP keepalive — each request gets a
                # fresh TCP connection through socat. Without this Caddy
                # would try to reuse a previously-tunneled connection,
                # which the HTTP-CONNECT proxy semantics don't support
                # (one CONNECT = one TCP stream).
                keepalive off
            }
        }
    }

    handle {
        respond "Unauthorized" 401 {
            close
        }
    }

    log {
        output stdout
        format json
    }
}
